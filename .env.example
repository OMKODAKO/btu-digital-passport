# Copy to .env.local and adjust. Stage 4 keys (PASSPORT_ADMIN_PRIVATE_KEY, PASSPORT_ISSUER_PRIVATE_KEY) are
# secrets: set them in the environment or a secret manager, never in this file or any committed file.

# Folder holding the SQLite database, stored PDFs and dev-credentials.txt (default: ./data)
DATA_DIR=./data

# Seed source: the passport generator's version registry (its PDFs sit next to it)
SEED_REGISTRY=tests/fixtures/seed/registry.json

# Student sign-in is limited to these email domains (comma-separated). BTU's test data uses example.org;
# production: BTU's own domain. Empty: no limit.
STUDENT_EMAIL_DOMAINS=example.org

# Stage 2 import worker
# PASSPORT_CONFIRMATION_COLUMN="Verification Status"
# PASSPORT_CONFIRMED_VALUES=CONFIRMED
# PASSPORT_CONFIRMATION_WHEN_ABSENT=AWARDED   # or HOLD

# Stage 3 issuance: blockchain (default; new versions wait for registration) or local-demo (issue without a chain)
PASSPORT_ISSUANCE_MODE=blockchain
# PASSPORT_ASSETS_DIR=worker/pdf/assets   # BTU template, stamps and fonts

# Stage 4 blockchain (see chain/README.md). Without these, new versions wait for registration.
# PASSPORT_CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# PASSPORT_CHAIN_ID=80002
# PASSPORT_CHAIN_NETWORK="Polygon Amoy testnet"
# PASSPORT_REGISTRY_ADDRESS=0x...
# PASSPORT_CHAIN_CONFIRMATIONS=3
# PASSPORT_CHAIN_MIN_PRIORITY_FEE_GWEI=30
# PASSPORT_TRUST_ANCHOR=https://<btu domain>/.well-known/btu-passport-issuer.json

# Printed in each new PDF's QR code: <VERIFY_BASE_URL>/<code>. The default is a placeholder BTU domain that does
# not serve this app yet; for a local demo use http://localhost:3000/verify
# VERIFY_BASE_URL=https://passport.btu.edu.ge/verify

# Stage 6: absolute base URL for the dashboard's verification QR code (default: the request's host)
# PUBLIC_BASE_URL=https://passport.btu.edu.ge
